# Copy this file to .env.local and fill in your own values.
# On Vercel, add the same keys under Project Settings → Environment Variables.

# MySQL / MariaDB connection
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=vibeboard

# Auth.js (NextAuth v5) — generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google sign-in — https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000 under "Authorized JavaScript origins" and
# http://localhost:3000/api/auth/callback/google under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as GOOGLE_CLIENT_ID; exposed to the browser for the personalized "Continue as" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Email (password reset + verification) — send from a Gmail account with a Google App Password
# (needs 2-Step Verification: https://myaccount.google.com/apppasswords). Leave blank in development
# to print emails to the dev-server console instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=VibeBoard

# Dashboard widgets (server-side only)
WEATHER_API_KEY=   # https://www.weatherapi.com
QUOTES_API_KEY=    # https://api-ninjas.com

# Canvas LMS integration
# 32-byte key, as 64 hex characters, used to encrypt stored Canvas tokens (AES-256-GCM):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CANVAS_TOKEN_ENC_KEY=
# Shared secret for the scheduled Canvas sync (Vercel sends it as a Bearer token on cron calls)
CRON_SECRET=
